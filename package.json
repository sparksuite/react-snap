{
  "name": "@sparksuite/react-snap",
  "version": "1.1.0",
  "description": "Zero-configuration framework-agnostic static prerendering for SPAs",
  "main": "index.js",
  "author": "stereobooster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparksuite/react-snap.git"
  },
  "engines": {
    "node": ">= 8.6.0"
  },
  "dependencies": {
    "express": "4.17.1",
    "express-history-api-fallback": "2.2.1",
    "highland": "2.13.4",
    "html-minifier": "4.0.0",
    "mkdirp": "0.5.1",
    "puppeteer": "^24.17.1",
    "serve-static": "1.14.1",
    "sourcemapped-stacktrace-node": "2.1.8",
    "yargs": "^17.5.1"
  },
  "devDependencies": {
    "dev-null-stream": "0.0.1",
    "jest": "24.9.0",
    "markdown-toc": "1.2.0",
    "prettier": "1.18.2"
  },
  "scripts": {
    "toc": "yarn run markdown-toc -i doc/recipes.md",
    "test": "jest",
    "format": "prettier --write {*,src/*}.{js,json,css}"
  },
  "bin": {
    "react-snap": "run.js"
  },
  "files": [
    "index.js",
    "run.js",
    "src/"
  ]
}
